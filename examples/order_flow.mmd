flowchart TD
    %% ===================== 样式定义 =====================
    classDef terminal fill:#1f77b4,stroke:#0d4d7a,stroke-width:2px,color:#ffffff
    classDef decision fill:#fff3cd,stroke:#ffc107,stroke-width:2px,color:#664d03
    classDef process  fill:#e7f1ff,stroke:#4a90d9,stroke-width:1.5px,color:#1a3a5c
    classDef danger   fill:#f8d7da,stroke:#dc3545,stroke-width:2px,color:#721c24
    classDef success  fill:#d4edda,stroke:#28a745,stroke-width:2px,color:#155724

    Start(["用户提交订单"]) --> A1

    %% ===================== ① 风控与建单 =====================
    subgraph G1["① 风控校验与订单创建"]
        A1{"基础风控评分"}
        A1 -->|"高危 ≥ 80"| A2["转人工审核队列"]
        A2 --> A3{"审核结论"}
        A3 -->|"拒绝"| A4["加入黑名单"]
        A3 -->|"通过"| A5["生成订单号<br/>写入订单主表"]
        A1 -->|"正常 < 80"| A5
    end

    A4 --> End1(["订单关闭"])

    %% ===================== ② 库存预占 =====================
    A5 --> B1
    subgraph G2["② 库存预占"]
        B1{"实时库存查询"}
        B1 -->|"完全充足"| B2["锁定库存<br/>写入预占记录"]
        B1 -->|"部分不足"| B3{"是否允许拆单"}
        B1 -->|"完全缺货"| B5["缺货登记"]
        B3 -->|"是"| B4["按仓库拆分子订单"]
        B3 -->|"否"| B5
        B4 --> B6["按子单分别锁定"]
    end

    B5 --> End1

    %% ===================== ③ 支付处理 =====================
    B2 --> C1
    B6 --> C1
    subgraph G3["③ 支付处理"]
        C1["进入支付环节"] --> C2{"选择支付方式"}
        C2 -->|"在线支付"| C3["调用支付网关"]
        C2 -->|"货到付款"| C9["标记为待收款"]
        C3 --> C4{"支付回调结果"}
        C4 -->|"超时无回调"| C10["主动轮询查单"]
        C10 --> C4
        C4 -->|"失败"| C6["通知用户支付失败"]
        C6 --> C7{"重试次数 < 3"}
        C7 -->|"是"| C3
        C7 -->|"否"| C8["释放已锁库存"]
        C4 -->|"成功"| C5["订单状态 = 已支付"]
    end

    C8 --> End1

    %% ===================== ④ 仓储履约 =====================
    C5 --> D1
    C9 --> D1
    subgraph G4["④ 仓储调度与履约"]
        D1{"仓储调度决策"}
        D1 -->|"本地仓有货"| D2["生成拣货单"]
        D1 -->|"本地仓缺货"| D3["触发采购 / 跨仓调拨"]
        D3 --> D4{"预计到货 < 48h"}
        D4 -->|"是"| D2
        D4 -->|"否"| D5["通知用户预计延期"]
        D5 --> D6{"用户是否接受"}
        D6 -->|"不接受"| End2(["订单取消并全额退款"])
        D6 -->|"接受"| D2
        D2 --> D7["复核打包出库"]
        D7 --> D8["交接物流配送"]
    end

    %% ===================== ⑤ 签收与售后 =====================
    D8 --> E1
    subgraph G5["⑤ 签收与售后"]
        E1{"物流签收结果"}
        E1 -->|"拒收"| E2["逆向物流回仓"]
        E1 -->|"已签收"| E3["确认收货<br/>订单完成"]
        E3 --> E4{"是否申请售后"}
        E4 -->|"退货"| E5["创建退货单"]
        E4 -->|"换货"| E6["创建换货单"]
        E4 -->|"无售后"| End3(["交易正式关闭"])
        E5 --> E7{"售后审核结论"}
        E6 --> E7
        E7 -->|"通过"| E8["生成售后处理单<br/>财务发起退款/补发"]
        E7 -->|"驳回"| E9["推送驳回原因"]
        E9 --> End3
        E2 --> E8
    end

    E8 --> End4(["售后流程结束"])

    %% ===================== 节点归类 =====================
    class Start,End1,End2,End3,End4 terminal
    class A1,A3,B1,B3,C2,C4,C7,D1,D4,D6,E1,E4,E7 decision
    class A2,A5,B2,B4,B6,C1,C3,C6,C9,C10,D2,D3,D5,D7,D8,E3,E5,E6 process
    class A4,B5,C8 danger
    class C5,E8 success
