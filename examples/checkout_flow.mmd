flowchart TD
    Start([开始]) --> Step1["验证购物车"]
    Step1 --> Decision1{有效?}
    Decision1 -->|否| Error1["❌ 返回修改"]
    Error1 --> End([结束])
    Decision1 -->|是| Step2["计算价格"]

    Step2 --> Decision2{正确?}
    Decision2 -->|否| Error2["❌ 重新计算"]
    Error2 --> End
    Decision2 -->|是| Step3["创建订单"]

    Step3 --> Decision3{成功?}
    Decision3 -->|否| Error3["❌ 系统错误"]
    Error3 --> End
    Decision3 -->|是| Step4["发起支付"]

    Step4 --> Decision4{支付成功?}
    Decision4 -->|否| Error4["❌ 支付失败"]
    Error4 --> End
    Decision4 -->|是| Step5["订单确认"]

    Step5 --> Step6["发送通知"]
    Step6 --> Success["✅ 完成"]
    Success --> End
